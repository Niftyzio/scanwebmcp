# Copy to .env.local (git-ignored) and fill in.
# Use a separate local or development project; never point contributors at production.
SUPABASE_URL=https://your-project-ref.supabase.co
# Dashboard → Project Settings → API keys → service_role (secret). Server-only; never NEXT_PUBLIC.
SUPABASE_SERVICE_ROLE_KEY=

# Required in production. Use long independent random values.
SCAN_RATE_SALT=
CRON_SECRET=
REPORT_ACCESS_SECRET=

# Canonical public origin and transactional email delivery.
NEXT_PUBLIC_BASE_URL=http://localhost:3000
EMAIL_FROM=ScanWebMCP.com <scan@example.com>
RESEND_API_KEY=

# Optional renderer fallbacks. Local Playwright is tried first.
FIRECRAWL_API_KEY=
BROWSER_WS_ENDPOINT=

# Queue tuning (1 by default, hard-capped at 2).
QUEUE_BATCH=1

# The email gate is on by default. Set "off" only for an intentional open-report campaign.
REPORT_GATE=on
